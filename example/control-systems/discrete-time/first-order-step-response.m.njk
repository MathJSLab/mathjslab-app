---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

state = 0;
response = zeros(1,25);
for k = 1:25
  state = 0.8*state+0.2;
  response(k) = state;
end
final_value = response(end)

% {{ comments.check[lang] }}
example_check = abs(final_value-(1-0.8^25)) < 1e-10 && all(diff(response) > 0) && final_value < 1
