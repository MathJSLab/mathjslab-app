---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

state = 4;
trajectory = zeros(1,9);
trajectory(1) = state;
for k = 1:8
  control_value = -0.4*state;
  state = 0.9*state+control_value;
  trajectory(k+1) = state;
end
trajectory

% {{ comments.check[lang] }}
example_check = abs(state-4*0.5^8) < 1e-10 && all(diff(trajectory) < 0)
