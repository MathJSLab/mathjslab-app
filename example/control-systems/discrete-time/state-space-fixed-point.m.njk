% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [0.5,0.1;0,0.25]
B = [0;1]
state = zeros(2,1);
for k = 1:25
  state = A*state+B;
end
steady_state = (eye(2)-A)\B

% {{ comments.check[lang] }}
example_check = max(abs(state-steady_state)) < 1e-6 && max(abs(A*steady_state+B-steady_state)) < 1e-10
