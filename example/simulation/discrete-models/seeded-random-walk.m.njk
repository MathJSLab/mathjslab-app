---json
{
    "comments": {
        "title": {
            "en": "Seeded random walk",
            "es": "Caminata aleatoria con semilla",
            "pt": "Caminhada aleatória com semente"
        },
        "goal": {
            "en": "Turn reproducible generator states into left and right steps.",
            "es": "Convertir estados reproducibles del generador en pasos a izquierda y derecha.",
            "pt": "Converter estados reprodutíveis do gerador em passos à esquerda e à direita."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        },
        "reference": {
            "en": "Topic reference (independently written example): https://people.sc.fsu.edu/~jburkardt/m_src/m_src.html",
            "es": "Referencia temática (ejemplo escrito de forma independiente): https://people.sc.fsu.edu/~jburkardt/m_src/m_src.html",
            "pt": "Referência temática (exemplo escrito de forma independente): https://people.sc.fsu.edu/~jburkardt/m_src/m_src.html"
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

rng(3)
initial_state = rng();
steps = 2*(rand(1,8) >= 0.5)-1;
positions = [0,cumsum(steps)]
rng(initial_state)
repeated_steps = 2*(rand(1,8) >= 0.5)-1;

% {{ comments.check[lang] }}
example_check = all(steps == repeated_steps) && positions(end) == sum(steps) && all(abs(steps) == 1)
