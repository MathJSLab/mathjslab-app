% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

state_value = 3; positions = zeros(1,9); steps = zeros(1,8);
for step_index = 1:8
 state_value = mod(5*state_value+1,16); steps(step_index) = 2*(state_value >= 8)-1; positions(step_index+1) = positions(step_index)+steps(step_index);
end

% {{ comments.check[lang] }}
example_check = all(positions == [0,-1,-2,-3,-2,-1,0,-1,0]) && all(abs(steps) == 1)
