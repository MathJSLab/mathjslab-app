% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

states = zeros(11,3); states(1,:) = [99,1,0]; beta_value = 0.3; gamma_value = 0.1; dt = 0.5;
for step_index = 1:10
 old_values = states(step_index,:); infections = dt*beta_value*old_values(1)*old_values(2)/100; recoveries = dt*gamma_value*old_values(2);
 states(step_index+1,:) = old_values+[-infections,infections-recoveries,recoveries];
end

% {{ comments.check[lang] }}
example_check = max(abs(sum(states,2)-100)) < 1e-10 && all(all(states >= 0)) && states(11,3) > 0
