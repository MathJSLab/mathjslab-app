% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

grid_values = zeros(4,9); grid_values(1,5) = 1;
for time_index = 1:3
 for position_index = 2:8
  grid_values(time_index+1,position_index) = mod(grid_values(time_index,position_index-1)+grid_values(time_index,position_index+1),2);
 end
end

% {{ comments.check[lang] }}
example_check = sum(grid_values(2,:)) == 2 && sum(grid_values(3,:)) == 2 && sum(grid_values(4,:)) == 4
