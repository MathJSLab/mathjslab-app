---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

temperatures = [0,0,1,0,0]; initial_energy = sum(temperatures); coefficient_value = 0.2;
for step_index = 1:6
 next_values = temperatures;
 for position_index = 2:4
  next_values(position_index) = temperatures(position_index)+coefficient_value*(temperatures(position_index-1)-2*temperatures(position_index)+temperatures(position_index+1));
 end
 temperatures = next_values;
end

% {{ comments.check[lang] }}
example_check = all(temperatures >= 0) && max(temperatures) < 1 && sum(temperatures) < initial_energy && temperatures(1) == 0 && temperatures(5) == 0
