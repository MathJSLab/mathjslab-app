% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

state_value = 3; states = zeros(1,8);
for step_index = 1:8
 state_value = mod(5*state_value+1,16); states(step_index) = state_value;
end
normalized_values = states/16;

% {{ comments.check[lang] }}
example_check = all(states == [0,1,6,15,12,13,2,11]) && all(normalized_values >= 0 & normalized_values < 1)
