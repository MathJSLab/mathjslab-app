% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

arrivals = [0,1,3,8]; durations = [2,3,2,1]; starts = zeros(1,4); completions = zeros(1,4);
for customer_index = 1:4
 previous_completion = 0;
 if customer_index > 1
  previous_completion = completions(customer_index-1);
 end
 starts(customer_index) = max([arrivals(customer_index),previous_completion]); completions(customer_index) = starts(customer_index)+durations(customer_index);
end
waits = starts-arrivals;

% {{ comments.check[lang] }}
example_check = all(starts == [0,2,5,8]) && all(waits == [0,1,2,0])
