        },
        "goal": {
            "en": "Calculate average length and Kraft sum for an explicitly prefix-free binary code.",
            "es": "Calcular longitud media y suma de Kraft de un código binario explícito sin prefijos.",
            "pt": "Calcular comprimento médio e soma de Kraft de um código binário explícito sem prefixos."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
