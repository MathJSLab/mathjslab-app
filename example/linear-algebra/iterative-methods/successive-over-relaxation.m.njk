% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

A = [4,1;1,3]; b = [1;2]; x = zeros(2,1); omega = 1.1;
for step_index = 1:20
 x(1) = (1-omega)*x(1)+omega*(b(1)-x(2))/4;
 x(2) = (1-omega)*x(2)+omega*(b(2)-x(1))/3;
end
residual = A*x-b

% {{ comments.check[lang] }}
example_check = max(abs(residual)) < 1e-9
