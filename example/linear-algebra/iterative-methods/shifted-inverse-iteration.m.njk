% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

A = [2,0;0,5]; shift_value = 4.8; v = [1;1];
for step_index = 1:10
 w = (A-shift_value*eye(2))\v; v = w/norm(w);
end
lambda_value = sum(sum(v.'*A*v))

% {{ comments.check[lang] }}
example_check = abs(lambda_value-5) < 1e-10
