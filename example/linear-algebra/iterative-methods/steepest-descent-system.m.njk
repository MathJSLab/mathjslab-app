A = [4,1;1,3]; b = [1;2]; x = zeros(2,1);
for step_index = 1:12
 r = b-A*x; alpha_value = sum(sum((r.'*r)/(r.'*A*r))); x = x+alpha_value*r;
end
residual = A*x-b

% {{ comments.check[lang] }}
example_check = max(abs(residual)) < 1e-6
