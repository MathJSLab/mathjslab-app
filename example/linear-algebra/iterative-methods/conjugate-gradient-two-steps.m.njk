% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

A = [4,1;1,3]; b = [1;2]; x = zeros(2,1); r = b-A*x; p = r;
for step_index = 1:2
 Ap = A*p; rr = r.'*r; alpha_value = sum(sum(rr/(p.'*Ap)));
 x = x+alpha_value*p; r = r-alpha_value*Ap;
 beta_value = sum(sum((r.'*r)/rr)); p = r+beta_value*p;
end
residual = A*x-b

% {{ comments.check[lang] }}
example_check = max(abs(residual)) < 1e-10
