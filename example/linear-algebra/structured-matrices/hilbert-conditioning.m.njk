% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

H = zeros(3,3);
for row_index = 1:3
 for column_index = 1:3
  H(row_index,column_index) = 1/(row_index+column_index-1);
 end
end
b = H*ones(3,1); x = H\b; delta_b = [0;0;0.001]; changed_x = H\(b+delta_b);

% {{ comments.check[lang] }}
example_check = max(abs(x-ones(3,1))) < 1e-8 && norm(changed_x-x) > 100*norm(delta_b)
