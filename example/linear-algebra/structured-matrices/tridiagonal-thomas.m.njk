% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

lower_values = [-1,-1]; diagonal_values = [2,2,2]; upper_values = [-1,-1]; rhs = [1,0,1];
for row_index = 2:3
 factor_value = lower_values(row_index-1)/diagonal_values(row_index-1);
 diagonal_values(row_index) = diagonal_values(row_index)-factor_value*upper_values(row_index-1);
 rhs(row_index) = rhs(row_index)-factor_value*rhs(row_index-1);
end
x = zeros(1,3); x(3) = rhs(3)/diagonal_values(3);
for row_index = 2:-1:1
 x(row_index) = (rhs(row_index)-upper_values(row_index)*x(row_index+1))/diagonal_values(row_index);
end

% {{ comments.check[lang] }}
example_check = max(abs(x-[1,1,1])) < 1e-10
