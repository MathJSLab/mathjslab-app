% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

A = [1,0;0,3]; B = [2,0;0,4]; C = [6,10;15,21]; X = zeros(2,2);
for row_index = 1:2
 for column_index = 1:2
  X(row_index,column_index) = C(row_index,column_index)/(A(row_index,row_index)+B(column_index,column_index));
 end
end

% {{ comments.check[lang] }}
example_check = max(max(abs(A*X+X*B-C))) < 1e-10
