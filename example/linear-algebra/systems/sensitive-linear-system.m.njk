---json
{
    "comments": {
        "title": {
            "en": "Sensitive linear system",
            "es": "Sistema lineal sensible",
            "pt": "Sistema linear sensível"
        },
        "goal": {
            "en": "Observe how a small right-hand-side perturbation changes a nearly singular solution.",
            "es": "Observar cómo una pequeña perturbación del término independiente cambia una solución casi singular.",
            "pt": "Observar como uma pequena perturbação do termo independente altera uma solução quase singular."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [1,1;1,1.001]
b = [2;2.001]
baseline_solution = A\b
perturbation = [0;0.001]
perturbed_solution = A\(b+perturbation)
solution_change = norm(perturbed_solution-baseline_solution)

% {{ comments.check[lang] }}
example_check = max(abs(baseline_solution-[1;1])) < 1e-8 && solution_change > 1 && norm(perturbation) == 0.001
