---json
{
    "comments": {
        "title": {
            "en": "Homogeneous affine transform",
            "es": "Transformación afín homogénea",
            "pt": "Transformação afim homogênea"
        },
        "goal": {
            "en": "Combine planar scaling and translation in homogeneous coordinates.",
            "es": "Combinar escalado y traslación en el plano con coordenadas homogéneas.",
            "pt": "Combinar escala e translação no plano com coordenadas homogêneas."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

transform = [2,0,5;0,2,-1;0,0,1]
point = [1;3;1]
transformed_point = transform*point
restored_point = transform\transformed_point

% {{ comments.check[lang] }}
example_check = all(transformed_point == [7;5;1]) && max(abs(restored_point-point)) < 1e-10
