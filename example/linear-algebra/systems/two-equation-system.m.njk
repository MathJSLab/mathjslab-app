---json
{
    "comments": {
        "title": {
            "en": "Two-equation system",
            "es": "Sistema de dos ecuaciones",
            "pt": "Sistema de duas equações"
        },
        "goal": {
            "en": "Solve a two-by-two system with left division and check its residual.",
            "es": "Resolver un sistema de dos por dos con división izquierda y comprobar el residuo.",
            "pt": "Resolver um sistema de dois por dois com divisão à esquerda e verificar o resíduo."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [3,2;1,-1]
b = [12; -1]
solution = A\b
residual = A*solution-b

% {{ comments.check[lang] }}
example_check = max(abs(residual)) < 1e-10 && max(abs(solution-[2;3])) < 1e-10
