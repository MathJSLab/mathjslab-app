% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [4,2;2,5]
l11 = sqrt(A(1,1));
l21 = A(2,1)/l11;
l22 = sqrt(A(2,2)-l21^2);
L = [l11,0;l21,l22]

% {{ comments.check[lang] }}
example_check = max(max(abs(L*L.'-A))) < 1e-10 && all(diag(L) > 0)
