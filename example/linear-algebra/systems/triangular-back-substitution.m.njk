% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

U = [2,1,-1;0,3,2;0,0,4]
b = [1;12;12]
solution = zeros(3,1);
for row_index = 3:-1:1
  known_total = sum(U(row_index,:).*(solution.'));
  solution(row_index) = (b(row_index)-known_total)/U(row_index,row_index);
end
solution

% {{ comments.check[lang] }}
example_check = max(abs(solution-[1;2;3])) < 1e-10 && max(abs(U*solution-b)) < 1e-10
