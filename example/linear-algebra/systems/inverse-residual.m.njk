---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [4,1;2,3]
inverse_matrix = inv(A)
identity_error = A*inverse_matrix-eye(2)
largest_error = max(max(abs(identity_error)))

% {{ comments.check[lang] }}
example_check = largest_error < 1e-10
