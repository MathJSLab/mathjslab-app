% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [4,1,0;1,4,1;0,1,4]
b = [6;12;14]
solution = zeros(3,1);
for iteration = 1:40
  next_solution = zeros(3,1);
  for row_index = 1:3
    other_terms = A(row_index,:)*solution-A(row_index,row_index)*solution(row_index);
    next_solution(row_index) = (b(row_index)-other_terms)/A(row_index,row_index);
  end
  solution = next_solution;
end
solution

% {{ comments.check[lang] }}
example_check = max(abs(A*solution-b)) < 1e-8 && max(abs(solution-[1;2;3])) < 1e-8
