            "es": "Sustitución progresiva",
            "pt": "Substituição progressiva"
        },
        "goal": {
            "en": "Solve a lower-triangular system using the entries already computed.",
            "es": "Resolver un sistema triangular inferior con las entradas ya calculadas.",
            "pt": "Resolver um sistema triangular inferior com os elementos já calculados."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
