---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

L = [2,0,0;1,3,0;-1,2,4]
b = [2;7;15]
solution = zeros(3,1);
for row_index = 1:3
  known_total = sum(L(row_index,:).*(solution.'));
  solution(row_index) = (b(row_index)-known_total)/L(row_index,row_index);
end
solution

% {{ comments.check[lang] }}
example_check = max(abs(solution-[1;2;3])) < 1e-10 && max(abs(L*solution-b)) < 1e-10
