% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [3,1;1,3]
trace_value = trace(A)
determinant_value = det(A)
discriminant = trace_value^2-4*determinant_value
eigenvalues = [(trace_value-sqrt(discriminant))/2,(trace_value+sqrt(discriminant))/2]

% {{ comments.check[lang] }}
example_check = all(eigenvalues == [2,4]) && abs(det(A-eigenvalues(1)*eye(2))) < 1e-10
