---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

A = [4,1;1,3]; b = [1;2]; x = A\b;
energy = 0.5*x.'*A*x-b.'*x;
y = x+[0.2;-0.1]; trial_energy = 0.5*y.'*A*y-b.'*y

% {{ comments.check[lang] }}
example_check = trial_energy > energy && max(abs(A*x-b)) < 1e-10
