A = [1,-2;3,4];
one_norm = max(sum(abs(A),1));
infinity_norm = max(sum(abs(A),2));
frobenius_norm = sqrt(sum(sum(A.^2)))

% {{ comments.check[lang] }}
example_check = one_norm == 6 && infinity_norm == 7 && abs(frobenius_norm-sqrt(30)) < 1e-10
