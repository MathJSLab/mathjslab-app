% {{ comments.reference[lang] }}
clear

v = [1;2;2]; P = (v*v.')/sum(v.^2); x = [3;1;0];
projected = P*x

% {{ comments.check[lang] }}
example_check = max(max(abs(P*P-P))) < 1e-10 && max(abs(P*projected-projected)) < 1e-10
