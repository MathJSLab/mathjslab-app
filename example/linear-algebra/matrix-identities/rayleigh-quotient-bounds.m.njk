% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

A = [2,0;0,5]; quotients = zeros(1,9);
for sample_index = 1:9
 phase_radians = (sample_index-1)*pi/16;
 v = [cos(phase_radians);sin(phase_radians)]; quotients(sample_index) = (v.'*A*v)/(v.'*v);
end

% {{ comments.check[lang] }}
example_check = min(quotients) >= 2-1e-10 && max(quotients) <= 5+1e-10
