---json
{
    "comments": {
        "title": {
            "en": "Compose function handles",
            "es": "Componer manejadores de función",
            "pt": "Compor function handles"
        },
        "goal": {
            "en": "Compose two anonymous functions and compare the result with a direct formula.",
            "es": "Componer dos funciones anónimas y comparar el resultado con una fórmula directa.",
            "pt": "Compor duas funções anônimas e comparar o resultado com uma fórmula direta."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

square_values = @(x) x.^2
shift_values = @(x) x+1
composed = @(x) square_values(shift_values(x))
values = [-1,0,2]
result = composed(values)

% {{ comments.check[lang] }}
example_check = all(result == [0,1,9])
