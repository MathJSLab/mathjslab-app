% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

function result = recursive_factorial(n)
  if n <= 1
    result = 1;
  else
    result = n*recursive_factorial(n-1);
  end
end
value = recursive_factorial(6)

% {{ comments.check[lang] }}
example_check = value == 720
