clear

function result = horner_value(coefficients,x)
  result = coefficients(1);
  for k = 2:numel(coefficients)
    result = result.*x+coefficients(k);
  end
end
evaluated = horner_value([2,-3,0,5],[0,1,2])

% {{ comments.check[lang] }}
example_check = all(evaluated == [5,4,9])
