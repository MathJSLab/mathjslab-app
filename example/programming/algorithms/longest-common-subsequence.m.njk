clear

first_tokens = [1,2,3,4]; second_tokens = [2,4,3]; lengths = zeros(5,4);
for i = 1:4
 for j = 1:3
  if first_tokens(i) == second_tokens(j)
   lengths(i+1,j+1) = lengths(i,j)+1;
  else
   lengths(i+1,j+1) = max([lengths(i,j+1),lengths(i+1,j)]);
  end
 end
end

