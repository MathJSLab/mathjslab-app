---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

tokens = [2,5,8,5,2]; palindrome_value = true;
for item_index = 1:floor(length(tokens)/2)
 if tokens(item_index) ~= tokens(length(tokens)+1-item_index)
  palindrome_value = false;
 end
end

% {{ comments.check[lang] }}
example_check = palindrome_value && tokens(3) == 8
