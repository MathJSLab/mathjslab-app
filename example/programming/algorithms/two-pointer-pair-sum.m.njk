% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

values = [1,3,4,7,11]; target_value = 10; left_index = 1; right_index = 5; found = false;
while left_index < right_index
 pair_total = values(left_index)+values(right_index);
 if pair_total == target_value
  found = true; break
 elseif pair_total < target_value
  left_index = left_index+1;
 else
  right_index = right_index-1;
 end
end

% {{ comments.check[lang] }}
example_check = found && left_index == 2 && right_index == 4
