% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

remaining_value = 84; factors = zeros(1,4); count_value = 0; divisor_value = 2;
while remaining_value > 1
 if mod(remaining_value,divisor_value) == 0
  count_value = count_value+1; factors(count_value) = divisor_value; remaining_value = remaining_value/divisor_value;
 else
  divisor_value = divisor_value+1;
 end
end

% {{ comments.check[lang] }}
example_check = all(factors == [2,2,3,7]) && prod(factors) == 84
