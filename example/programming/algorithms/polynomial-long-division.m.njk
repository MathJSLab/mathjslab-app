% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

numerator_values = [1,-3,2]; divisor_values = [1,-1]; quotient_values = zeros(1,2); remainder_values = numerator_values;
for term_index = 1:2
 quotient_values(term_index) = remainder_values(term_index)/divisor_values(1);
 remainder_values(term_index:term_index+1) = remainder_values(term_index:term_index+1)-quotient_values(term_index)*divisor_values;
end

% {{ comments.check[lang] }}
example_check = all(quotient_values == [1,-2]) && all(remainder_values == [0,0,0])
