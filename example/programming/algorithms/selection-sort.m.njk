---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

values = [7,2,9,2,1]; best_slot = [1,0];
for left_index = 1:4
 best_slot(1) = left_index;
 for candidate_index = (left_index+1):5
  if values(candidate_index) < values(best_slot(1))
   best_slot(1) = candidate_index;
  end
 end
 saved_value = values(left_index); values(left_index) = values(best_slot(1)); values(best_slot(1)) = saved_value;
end

% {{ comments.check[lang] }}
example_check = all(values == [1,2,2,7,9])
