% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

coins = [1,3,4]; target_amount = 6; costs = 99*ones(1,7); costs(1) = 0;
for amount_value = 1:6
 for coin_index = 1:3
  if coins(coin_index) <= amount_value
   proposal = 1+costs(amount_value-coins(coin_index)+1);
   if proposal < costs(amount_value+1)
    costs(amount_value+1) = proposal;
   end
  end
 end
end

% {{ comments.check[lang] }}
example_check = costs(7) == 2 && costs(5) == 1
