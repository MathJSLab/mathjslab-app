% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

first_tokens = [1,2,3]; second_tokens = [1,4,3,5]; costs = zeros(4,5); costs(:,1) = (0:3).'; costs(1,:) = 0:4;
for i = 1:3
 for j = 1:4
  mismatch = first_tokens(i) ~= second_tokens(j);
  costs(i+1,j+1) = min([costs(i,j+1)+1,costs(i+1,j)+1,costs(i,j)+mismatch]);
 end
end

% {{ comments.check[lang] }}
example_check = costs(4,5) == 2
