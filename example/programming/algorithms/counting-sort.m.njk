clear

values = [3,0,2,3,1,0]; counts = zeros(1,4);
for item_index = 1:6
 key_index = values(item_index)+1; counts(key_index) = counts(key_index)+1;
end
ordered = zeros(1,6); output_index = 1;
for key_value = 0:3
 for repetition_index = 1:counts(key_value+1)
  ordered(output_index) = key_value; output_index = output_index+1;
 end
end

% {{ comments.check[lang] }}
example_check = all(ordered == [0,0,1,2,3,3])
