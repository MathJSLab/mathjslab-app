---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

tokens = [2,2,2,5,5,1]; run_values = zeros(1,3); run_counts = zeros(1,3); run_index = 1; run_values(1) = tokens(1);
for item_index = 1:6
 if tokens(item_index) ~= run_values(run_index)
  run_index = run_index+1; run_values(run_index) = tokens(item_index);
 end
 run_counts(run_index) = run_counts(run_index)+1;
end

% {{ comments.check[lang] }}
example_check = all(run_values == [2,5,1]) && all(run_counts == [3,2,1])
