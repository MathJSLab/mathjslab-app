---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

values = [5,1,4,2,3];
for pass_index = 1:4
 for item_index = 1:5-pass_index
  if values(item_index) > values(item_index+1)
   saved_value = values(item_index); values(item_index) = values(item_index+1); values(item_index+1) = saved_value;
  end
 end
end

% {{ comments.check[lang] }}
example_check = all(values == [1,2,3,4,5])
