% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

left_values = [1,4,7]; right_values = [2,3,8]; merged = zeros(1,6); i = 1; j = 1;
for output_index = 1:6
 if i > 3
  merged(output_index) = right_values(j); j = j+1;
 elseif j > 3
  merged(output_index) = left_values(i); i = i+1;
 elseif left_values(i) <= right_values(j)
  merged(output_index) = left_values(i); i = i+1;
 else
  merged(output_index) = right_values(j); j = j+1;
 end
end

% {{ comments.check[lang] }}
example_check = all(merged == [1,2,3,4,7,8])
