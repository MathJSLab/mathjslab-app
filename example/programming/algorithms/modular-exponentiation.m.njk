% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

base_value = 7; exponent_value = 13; modulus_value = 11; product_value = 1;
while exponent_value > 0
 if mod(exponent_value,2) == 1
  product_value = mod(product_value*base_value,modulus_value);
 end
 base_value = mod(base_value^2,modulus_value); exponent_value = floor(exponent_value/2);
end

% {{ comments.check[lang] }}
example_check = product_value == 2
