% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

weights = [2,3,4]; benefits = [3,4,5]; capacity_value = 5; table_values = zeros(4,6);
for item_index = 1:3
 for room_value = 0:5
  table_values(item_index+1,room_value+1) = table_values(item_index,room_value+1);
  if weights(item_index) <= room_value
   proposal = benefits(item_index)+table_values(item_index,room_value-weights(item_index)+1);
   table_values(item_index+1,room_value+1) = max([table_values(item_index+1,room_value+1),proposal]);
  end
 end
end

% {{ comments.check[lang] }}
example_check = table_values(4,6) == 7
