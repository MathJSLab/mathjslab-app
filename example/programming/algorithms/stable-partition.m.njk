% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

values = [5,2,7,4,3,6]; output_values = zeros(1,6); output_index = 1;
for parity_value = 0:1
 for item_index = 1:6
  if mod(values(item_index),2) == parity_value
   output_values(output_index) = values(item_index); output_index = output_index+1;
  end
 end
end

% {{ comments.check[lang] }}
example_check = all(output_values == [2,4,6,5,7,3])
