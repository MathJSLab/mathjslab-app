% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

keys = [1,6,11]; table_keys = zeros(1,5); occupied_values = zeros(1,5);
for item_index = 1:3
 slot_index = mod(keys(item_index),5)+1;
 while occupied_values(slot_index)
  slot_index = mod(slot_index,5)+1;
 end
 table_keys(slot_index) = keys(item_index); occupied_values(slot_index) = 1;
end

% {{ comments.check[lang] }}
example_check = all(table_keys == [0,1,6,11,0]) && sum(occupied_values) == 3
