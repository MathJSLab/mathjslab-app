% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

priorities = [4,1,3]; identifiers = [40,10,30]; active_values = [1,1,1]; best_index = 0;
for item_index = 1:3
 if active_values(item_index)
  if best_index == 0
   best_index = item_index;
  elseif priorities(item_index) < priorities(best_index)
   best_index = item_index;
  end
 end
end
removed_id = identifiers(best_index); active_values(best_index) = 0;

% {{ comments.check[lang] }}
example_check = removed_id == 10 && sum(active_values) == 2
