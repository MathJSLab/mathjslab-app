    "comments": {
        "title": {
            "en": "Linked list reversal",
            "es": "Inversión de lista enlazada",
            "pt": "Inversão de lista encadeada"
        },
        "goal": {
            "en": "Reverse next-node links without moving stored values.",
            "es": "Invertir enlaces al siguiente nodo sin mover los valores almacenados.",
            "pt": "Inverter ligações ao próximo nó sem mover os valores armazenados."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        },
        "reference": {
            "en": "Topic reference (independently written example): https://github.com/TheAlgorithms/MATLAB-Octave",
