---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

next_nodes = [2,3,0]; previous_index = 0; current_index = 1;
while current_index ~= 0
 saved_index = next_nodes(current_index); next_nodes(current_index) = previous_index; previous_index = current_index; current_index = saved_index;
end
head_index = previous_index;

% {{ comments.check[lang] }}
example_check = head_index == 3 && all(next_nodes == [0,1,2])
