% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

heap_values = [2,5,4,8,7,3]; child_index = 6;
while child_index > 1
 parent_index = floor(child_index/2);
 if heap_values(parent_index) <= heap_values(child_index)
  break
 end
 saved_value = heap_values(parent_index); heap_values(parent_index) = heap_values(child_index); heap_values(child_index) = saved_value;
 child_index = parent_index;
end

% {{ comments.check[lang] }}
example_check = all(heap_values == [2,5,3,8,7,4])
