keys = [8,3,12,1,6]; left_children = [2,4,0,0,0]; right_children = [3,5,0,0,0]; target_value = 6; node_index = 1;
while node_index ~= 0
 if target_value == keys(node_index)
  break
 elseif target_value < keys(node_index)
  node_index = left_children(node_index);
 else
  node_index = right_children(node_index);
 end
end

