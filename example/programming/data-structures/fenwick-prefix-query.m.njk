% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

values = [3,1,4,1,5,9,2,6]; low_bits = [1,2,1,4,1,2,1,8]; tree_values = zeros(1,8);
for item_index = 1:8
 tree_values(item_index) = sum(values(item_index-low_bits(item_index)+1:item_index));
end
query_index = 7; prefix_total = 0;
while query_index > 0
 prefix_total = prefix_total+tree_values(query_index); query_index = query_index-low_bits(query_index);
end

% {{ comments.check[lang] }}
example_check = prefix_total == 25 && tree_values(8) == 31
