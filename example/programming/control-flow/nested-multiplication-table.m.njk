clear

table = zeros(4,4);
for row_index = 1:4
  for column_index = 1:4
    table(row_index,column_index) = row_index*column_index;
  end
end
table

% {{ comments.check[lang] }}
example_check = table(3,4) == 12 && all(all(table == table.'))
