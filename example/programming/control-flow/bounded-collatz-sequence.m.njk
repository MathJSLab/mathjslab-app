{
    "comments": {
        "title": {
            "en": "Bounded Collatz sequence",
            "es": "Secuencia de Collatz acotada",
            "pt": "Sequência de Collatz limitada"
        },
        "goal": {
            "en": "Follow the Collatz rule from six with a twenty-step cap, without claiming general convergence.",
            "es": "Seguir la regla de Collatz desde seis con límite de veinte pasos, sin afirmar convergencia general.",
            "pt": "Seguir a regra de Collatz a partir de seis com limite de vinte passos, sem afirmar convergência geral."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
