---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

value = 6;
sequence = zeros(1,21);
sequence(1) = value;
step_count = 0;
while value ~= 1 && step_count < 20
  if mod(value,2) == 0
    value = value/2;
  else
    value = 3*value+1;
  end
  step_count = step_count+1;
  sequence(step_count+1) = value;
end
sequence = sequence(1:step_count+1)

% {{ comments.check[lang] }}
example_check = value == 1 && step_count == 8 && all(sequence == [6,3,10,5,16,8,4,2,1])
