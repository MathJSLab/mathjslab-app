classdef GeometryTools
  methods (Static)
    function value = distance(a,b)
      value = sqrt(sum((a-b).^2));
    end
  end
end
distance_value = GeometryTools.distance([1,2],[4,6])

% {{ comments.check[lang] }}
example_check = distance_value == 5
