---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

classdef BaseMeasurement
  properties
    Value = 4;
  end
  methods
    function result = doubled(obj)
      result = 2*obj.Value;
    end
  end
end
classdef LabeledMeasurement < BaseMeasurement
  properties
    Code = 7;
  end
end
measurement = LabeledMeasurement();
result = measurement.doubled()

% {{ comments.check[lang] }}
example_check = result == 8 && measurement.Code == 7
