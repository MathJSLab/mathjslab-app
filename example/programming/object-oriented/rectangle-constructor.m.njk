---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

classdef StudyRectangle
  properties
    Width = 0;
    Height = 0;
  end
  methods
    function obj = StudyRectangle(width,height)
      obj.Width = width;
      obj.Height = height;
    end
    function value = area(obj)
      value = obj.Width*obj.Height;
    end
  end
end
rectangle = StudyRectangle(3,4);
area_value = rectangle.area()

% {{ comments.check[lang] }}
example_check = area_value == 12 && rectangle.Width == 3
