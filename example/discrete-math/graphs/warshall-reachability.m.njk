---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

adjacency = [0,1,0;0,0,1;0,0,0]
reachable = (adjacency+eye(3)) > 0;
for intermediate = 1:3
  for start_index = 1:3
    for end_index = 1:3
      reachable(start_index,end_index) = reachable(start_index,end_index) || (reachable(start_index,intermediate) && reachable(intermediate,end_index));
    end
  end
end
reachable

% {{ comments.check[lang] }}
example_check = reachable(1,3) && ~reachable(3,1) && sum(sum(reachable)) == 6
