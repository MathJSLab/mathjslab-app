---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

original_value = 13;
remaining_value = original_value;
digits = zeros(1,4);
for k = 1:4
  digits(k) = mod(remaining_value,2);
  remaining_value = floor(remaining_value/2);
end
digits
reconstructed = sum(digits.*2.^(0:3))

% {{ comments.check[lang] }}
example_check = all(digits == [1,0,1,1]) && reconstructed == original_value && remaining_value == 0
