        },
        "goal": {
            "en": "Recover least-significant-first binary digits by successive integer division.",
            "es": "Recuperar dígitos binarios del menos significativo al más mediante división entera sucesiva.",
            "pt": "Recuperar dígitos binários do menos significativo para o mais por divisão inteira sucessiva."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
