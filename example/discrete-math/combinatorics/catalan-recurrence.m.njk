---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

counts = zeros(1,7);
counts(1) = 1;
for n = 1:6
  for k = 0:n-1
    counts(n+1) = counts(n+1)+counts(k+1)*counts(n-k);
  end
end
counts

% {{ comments.check[lang] }}
example_check = all(counts == [1,1,2,5,14,42,132])
