% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

vertices = [0,0;4,0;4,2;0,2]; cross_values = zeros(1,4); weighted_values = zeros(4,2);
for edge_index = 1:4
 next_index = mod(edge_index,4)+1; a = vertices(edge_index,:); b = vertices(next_index,:);
 cross_values(edge_index) = a(1)*b(2)-b(1)*a(2); weighted_values(edge_index,:) = (a+b)*cross_values(edge_index);
end
signed_area = sum(cross_values)/2; centroid = sum(weighted_values,1)/(6*signed_area);

% {{ comments.check[lang] }}
example_check = signed_area == 8 && max(abs(centroid-[2,1])) < 1e-10
