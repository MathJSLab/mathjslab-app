% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

vertices = [0,0;4,0;4,3;0,3]; point_value = [1,1]; crossing_values = zeros(1,4);
for edge_index = 1:4
 a = vertices(edge_index,:); b = vertices(mod(edge_index,4)+1,:);
 if (a(2) > point_value(2)) ~= (b(2) > point_value(2))
  crossing_x = a(1)+(point_value(2)-a(2))*(b(1)-a(1))/(b(2)-a(2));
  crossing_values(edge_index) = crossing_x > point_value(1);
 end
end
inside_value = mod(sum(crossing_values),2) == 1;

% {{ comments.check[lang] }}
example_check = inside_value && sum(crossing_values) == 1
