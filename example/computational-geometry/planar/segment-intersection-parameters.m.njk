---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

a = [0;0]; b = [4;4]; c = [0;4]; d = [4;0];
parameters = [b-a,-(d-c)]\(c-a); intersection_point = a+parameters(1)*(b-a);

% {{ comments.check[lang] }}
example_check = all(parameters >= 0 & parameters <= 1) && max(abs(intersection_point-[2;2])) < 1e-10
