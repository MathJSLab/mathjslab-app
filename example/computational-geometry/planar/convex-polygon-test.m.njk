% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

vertices = [0,0;3,0;4,2;1,3]; turns = zeros(1,4);
for vertex_index = 1:4
 a = vertices(vertex_index,:); b = vertices(mod(vertex_index,4)+1,:); c = vertices(mod(vertex_index+1,4)+1,:);
 u = b-a; v = c-b; turns(vertex_index) = u(1)*v(2)-u(2)*v(1);
end

% {{ comments.check[lang] }}
example_check = all(turns > 0)
