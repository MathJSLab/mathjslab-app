---json
{
    "comments": {
        "title": {
            "en": "Composite trapezoidal rule",
            "es": "Regla trapezoidal compuesta",
            "pt": "Regra dos trapézios composta"
        },
        "goal": {
            "en": "Compare a forty-trapezoid formula with trapz and cumulative integration for x squared on zero to one.",
            "es": "Comparar una fórmula de cuarenta trapecios con trapz y la integración acumulada de x al cuadrado entre cero y uno.",
            "pt": "Comparar uma fórmula com quarenta trapézios com trapz e a integração acumulada de x ao quadrado entre zero e um."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

x = linspace(0,1,41)
y = x.^2
width = x(2)-x(1)
area = width*(sum(y)-0.5*y(1)-0.5*y(end))
exact_area = 1/3
native_area = trapz(x,y)
cumulative_area = cumtrapz(x,y)
absolute_error = abs(area-exact_area)

% {{ comments.check[lang] }}
example_check = absolute_error < 0.0002 && abs(native_area-area) < 1e-12 && abs(cumulative_area(end)-area) < 1e-12
