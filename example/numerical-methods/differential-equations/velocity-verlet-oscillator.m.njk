---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

x = 1;
velocity = 0;
dt = 0.05;
energy = zeros(1,81);
energy(1) = 0.5;
for k = 1:80
  half_velocity = velocity-dt*x/2;
  x = x+dt*half_velocity;
  velocity = half_velocity-dt*x/2;
  energy(k+1) = (x^2+velocity^2)/2;
end
largest_energy_error = max(abs(energy-0.5))

% {{ comments.check[lang] }}
example_check = largest_energy_error < 0.0004
