---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

steps = 200;
dt = 0.02;
x = 1;
velocity = 0;
energy = zeros(1,steps+1);
energy(1) = 0.5;
for k = 1:steps
  velocity = velocity-dt*x;
  x = x+dt*velocity;
  energy(k+1) = (x^2+velocity^2)/2;
end
final_position = x
largest_energy_error = max(abs(energy-0.5))

% {{ comments.check[lang] }}
example_check = largest_energy_error < 0.01
