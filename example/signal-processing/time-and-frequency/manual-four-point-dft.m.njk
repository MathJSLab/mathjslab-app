% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

samples = [1,0,-1,0];
coefficients = zeros(1,4);
for frequency_index = 0:3
  for sample_index = 0:3
    phase_radians = -2*pi*frequency_index*sample_index/4;
    coefficients(frequency_index+1) = coefficients(frequency_index+1)+samples(sample_index+1)*exp(1i*phase_radians);
  end
end
coefficients

% {{ comments.check[lang] }}
example_check = max(abs(coefficients-[0,2,0,2])) < 1e-10
