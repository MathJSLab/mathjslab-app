---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

samples = [1,2,3];
kernel_values = [1,2,1];
filtered = zeros(1,5);
for sample_index = 1:3
  for kernel_index = 1:3
    output_index = sample_index+kernel_index-1;
    filtered(output_index) = filtered(output_index)+samples(sample_index)*kernel_values(kernel_index);
  end
end
filtered

% {{ comments.check[lang] }}
example_check = all(filtered == [1,4,8,8,3])
