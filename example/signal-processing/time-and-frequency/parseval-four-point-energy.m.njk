---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

samples = [1,2,1,0]
coefficients = [4,-2i,0,2i]
time_energy = sum(abs(samples).^2)
frequency_energy = sum(abs(coefficients).^2)/numel(samples)

% {{ comments.check[lang] }}
example_check = time_energy == 6 && frequency_energy == time_energy
