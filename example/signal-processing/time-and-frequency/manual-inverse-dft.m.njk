---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

coefficients = [0,2,0,2];
recovered = zeros(1,4);
for sample_index = 0:3
  for frequency_index = 0:3
    phase_radians = 2*pi*frequency_index*sample_index/4;
    recovered(sample_index+1) = recovered(sample_index+1)+coefficients(frequency_index+1)*exp(1i*phase_radians)/4;
  end
end
recovered

% {{ comments.check[lang] }}
example_check = max(abs(recovered-[1,0,-1,0])) < 1e-10
