        },
        "goal": {
            "en": "Wrap indices modulo four to calculate circular rather than full linear convolution.",
            "es": "Envolver índices módulo cuatro para calcular convolución circular en lugar de lineal completa.",
            "pt": "Circular índices módulo quatro para calcular convolução circular em vez de linear completa."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
