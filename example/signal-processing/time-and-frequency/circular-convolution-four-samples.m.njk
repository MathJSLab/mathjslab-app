---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

samples = [1,2,3,4];
kernel_values = [1,0,1,0];
output_values = zeros(1,4);
for output_index = 0:3
  for input_index = 0:3
    kernel_index = mod(output_index-input_index+4,4)+1;
    output_values(output_index+1) = output_values(output_index+1)+samples(input_index+1)*kernel_values(kernel_index);
  end
end
output_values

% {{ comments.check[lang] }}
example_check = all(output_values == [4,6,4,6])
