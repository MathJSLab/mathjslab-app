---json
{
    "comments": {
        "title": {
            "en": "Numeric image threshold",
            "es": "Umbral de imagen numérica",
            "pt": "Limiar de imagem numérica"
        },
        "goal": {
            "en": "Convert a small grayscale matrix into a logical mask using a fixed threshold.",
            "es": "Convertir una pequeña matriz de grises en una máscara lógica con un umbral fijo.",
            "pt": "Converter uma pequena matriz de tons de cinza numa máscara lógica com limiar fixo."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

image = [0,50,200;100,150,255;30,90,180]
mask = image >= 128
bright_pixels = sum(sum(mask))
fraction = bright_pixels/numel(image)

% {{ comments.check[lang] }}
example_check = bright_pixels == 4 && abs(fraction-4/9) < 1e-10
