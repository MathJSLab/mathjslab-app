% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

x = [0,4,0,0]
y = [0,0,3,0]
edge_lengths = sqrt(diff(x).^2+diff(y).^2)
perimeter = sum(edge_lengths)

% {{ comments.check[lang] }}
example_check = all(edge_lengths == [4,5,3]) && perimeter == 12
