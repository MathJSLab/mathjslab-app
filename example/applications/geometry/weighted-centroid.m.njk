{
    "comments": {
        "title": {
            "en": "Weighted centroid",
            "es": "Centroide ponderado",
            "pt": "Centroide ponderado"
        },
        "goal": {
            "en": "Compute the center of three point masses from weighted coordinates.",
            "es": "Calcular el centro de tres masas puntuales con coordenadas ponderadas.",
            "pt": "Calcular o centro de três massas pontuais com coordenadas ponderadas."
        },
