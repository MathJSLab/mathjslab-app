---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

masses = [1,2,1]
x = [0,2,4]
y = [0,3,0]
centroid_x = sum(masses.*x)/sum(masses)
centroid_y = sum(masses.*y)/sum(masses)

% {{ comments.check[lang] }}
example_check = centroid_x == 2 && centroid_y == 1.5
