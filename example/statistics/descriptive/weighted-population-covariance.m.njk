---json
{
    "comments": {
        "title": {
            "en": "Weighted population covariance",
            "es": "Covarianza poblacional ponderada",
            "pt": "Covariância populacional ponderada"
        },
        "goal": {
            "en": "Center paired data with normalized weights and calculate population covariance.",
            "es": "Centrar datos emparejados con pesos normalizados y calcular covarianza poblacional.",
            "pt": "Centrar dados pareados com pesos normalizados e calcular covariância populacional."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

x = [1,2,4]
y = [2,4,8]
weights = [0.2,0.3,0.5]
average_x = sum(weights.*x)
average_y = sum(weights.*y)
covariance_value = sum(weights.*(x-average_x).*(y-average_y))

% {{ comments.check[lang] }}
example_check = abs(sum(weights)-1) < 1e-10 && abs(covariance_value-3.12) < 1e-10
