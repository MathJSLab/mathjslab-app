% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

observations = [1,2,1,3,2,1,3,3,1]
categories = 1:3
counts = zeros(1,3);
for k = 1:3
  counts(k) = sum(observations == categories(k));
end
relative_frequencies = counts/numel(observations)

% {{ comments.check[lang] }}
example_check = all(counts == [4,2,3]) && abs(sum(relative_frequencies)-1) < 1e-10
