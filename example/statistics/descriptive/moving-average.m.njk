---json
{
    "comments": {
        "title": {
            "en": "Three-point moving average",
            "es": "Media móvil de tres puntos",
            "pt": "Média móvel de três pontos"
        },
        "signal": {
            "en": "short noisy signal",
            "es": "señal corta con ruido",
            "pt": "sinal curto com ruído"
        },
        "average": {
            "en": "average each group of three consecutive values",
            "es": "promediar cada grupo de tres valores consecutivos",
            "pt": "calcular a média de cada grupo de três valores consecutivos"
        },
        "check": {
            "en": "check the expected averages; true means the check passed",
            "es": "comprobar los promedios esperados; true indica que la comprobación pasó",
            "pt": "verificar as médias esperadas; true indica que a verificação passou"
        }
    }
}
---
% {{ comments.title[lang] }}
clear
% {{ comments.signal[lang] }}
samples = [3, 4, 8, 6, 5, 7, 9]
% {{ comments.average[lang] }}
moving_average = (samples(1:5) + samples(2:6) + samples(3:7))/3
% {{ comments.check[lang] }}
example_check = max(abs(moving_average-[5,6,19/3,6,7])) < 1e-10
