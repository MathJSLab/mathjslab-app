---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

data = [-1,-1,1,1]
deviations = data-mean(data)
variance_value = mean(deviations.^2)
pearson_kurtosis = mean(deviations.^4)/variance_value^2
excess_kurtosis = pearson_kurtosis-3

% {{ comments.check[lang] }}
example_check = pearson_kurtosis == 1 && excess_kurtosis == -2
