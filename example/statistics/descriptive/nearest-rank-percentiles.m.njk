---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

data = [9,1,7,3,5,2,10,4,8,6]
ordered = sort(data)
probabilities = [0.25,0.5,0.75]
indices = ceil(probabilities*numel(data))
percentiles = ordered(indices)

% {{ comments.check[lang] }}
example_check = all(percentiles == [3,5,8])
