        },
        "goal": {
            "en": "Use positions one plus n minus one times p, then interpolate adjacent sorted values.",
            "es": "Usar posiciones uno más n menos uno por p e interpolar valores ordenados adyacentes.",
            "pt": "Usar posições um mais n menos um vezes p e interpolar valores ordenados adjacentes."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
