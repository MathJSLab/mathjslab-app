---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

data = [5,1,3,2,4];
ordered = sort(data);
probabilities = [0.3,0.6];
quantiles = zeros(1,2);
for k = 1:2
  position = 1+(numel(data)-1)*probabilities(k);
  lower_index = floor(position);
  fraction = position-lower_index;
  quantiles(k) = ordered(lower_index)+fraction*(ordered(lower_index+1)-ordered(lower_index));
end
quantiles

% {{ comments.check[lang] }}
example_check = max(abs(quantiles-[2.2,3.4])) < 1e-10
