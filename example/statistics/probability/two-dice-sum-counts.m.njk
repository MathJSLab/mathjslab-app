---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

counts = zeros(1,11);
for first_die = 1:6
  for second_die = 1:6
    position = first_die+second_die-1;
    counts(position) = counts(position)+1;
  end
end
counts
probabilities = counts/36

% {{ comments.check[lang] }}
example_check = all(counts == [1,2,3,4,5,6,5,4,3,2,1]) && abs(sum(probabilities)-1) < 1e-10
