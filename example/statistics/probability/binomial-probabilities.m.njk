% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

n = 4
p = 0.5
probabilities = zeros(1,n+1);
for k = 0:n
  combinations = factorial(n)/(factorial(k)*factorial(n-k));
  probabilities(k+1) = combinations*p^k*(1-p)^(n-k);
end

% {{ comments.check[lang] }}
example_check = abs(sum(probabilities)-1) < 1e-10 && probabilities(3) == 0.375
