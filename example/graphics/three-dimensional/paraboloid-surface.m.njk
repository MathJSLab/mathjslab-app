---json
{
    "comments": {
        "title": {
            "en": "Paraboloid surface",
            "es": "Superficie paraboloide",
            "pt": "Superfície paraboloide"
        },
        "goal": {
            "en": "Build a small mesh and plot a nonnegative bowl-shaped surface.",
            "es": "Construir una malla pequeña y graficar una superficie no negativa en forma de cuenco.",
            "pt": "Construir uma pequena malha e traçar uma superfície não negativa em forma de tigela."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

axis_values = linspace(-2,2,9);
[X,Y] = meshgrid(axis_values,axis_values);
Z = X.^2+Y.^2;
surf(X,Y,Z)

% {{ comments.check[lang] }}
example_check = all(size(Z) == [9,9]) && min(min(Z)) == 0 && max(max(Z)) == 8
