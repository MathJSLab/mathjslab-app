---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

time = linspace(0,5,31);
population = 100*exp(0.2*time);
plot(time,population)
growth_factor = population(end)/population(1)

% {{ comments.check[lang] }}
example_check = abs(growth_factor-exp(1)) < 1e-10 && all(diff(population) > 0)
