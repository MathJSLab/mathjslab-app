% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

t = linspace(0,2*pi,101);
x = sin(2*t);
y = sin(3*t);
plot(x,y)

% {{ comments.check[lang] }}
example_check = numel(x) == 101 && abs(x(1)-x(end)) < 1e-10 && abs(y(1)-y(end)) < 1e-10
