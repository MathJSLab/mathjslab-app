---json
{
    "comments": {
        "title": {
            "en": "Rational bell curve",
            "es": "Curva de campana racional",
            "pt": "Curva de sino racional"
        },
        "goal": {
            "en": "Draw one over one plus x squared without any singular points in the sampled interval.",
            "es": "Dibujar uno sobre uno más x al cuadrado sin singularidades en el intervalo muestreado.",
            "pt": "Traçar um sobre um mais x ao quadrado sem singularidades no intervalo amostrado."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

x = linspace(-4,4,41);
y = 1./(1+x.^2);
plot(x,y)

% {{ comments.check[lang] }}
example_check = y(21) == 1 && abs(y(1)-1/17) < 1e-10 && all(y > 0)
