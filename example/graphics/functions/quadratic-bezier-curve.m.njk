% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

t = linspace(0,1,21);
x = 2*(1-t).*t+3*t.^2;
y = 4*(1-t).*t;
plot(x,y)

% {{ comments.check[lang] }}
example_check = x(1) == 0 && x(end) == 3 && abs(x(11)-1.25) < 1e-10 && abs(y(11)-1) < 1e-10
