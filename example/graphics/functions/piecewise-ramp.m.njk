% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

x = linspace(-1,2,31);
y = zeros(1,numel(x));
for k = 1:numel(x)
  if x(k) < 0
    y(k) = 0;
  elseif x(k) > 1
    y(k) = 1;
  else
    y(k) = x(k);
  end
end
plot(x,y)

% {{ comments.check[lang] }}
example_check = all(y >= 0) && all(y <= 1) && y(1) == 0 && y(end) == 1
