---json
{
    "comments": {
        "title": {
            "en": "Archimedean spiral",
            "es": "Espiral de Arquímedes",
            "pt": "Espiral de Arquimedes"
        },
        "goal": {
            "en": "Draw a spiral whose radius grows linearly with its polar angle.",
            "es": "Dibujar una espiral cuyo radio crece linealmente con el ángulo polar.",
            "pt": "Traçar uma espiral cujo raio cresce linearmente com o ângulo polar."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

phases = linspace(0,4*pi,81);
radii = 0.2*phases;
x = radii.*cos(phases);
y = radii.*sin(phases);
plot(x,y)
recovered_radii = sqrt(x.^2+y.^2);

% {{ comments.check[lang] }}
example_check = max(abs(recovered_radii-radii)) < 1e-10 && all(diff(radii) > 0)
