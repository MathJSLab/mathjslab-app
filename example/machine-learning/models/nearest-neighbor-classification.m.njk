% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

training_points = [0,0;1,0;4,4]; labels = [1,1,2]; query_point = [3.5,4]; distances = zeros(1,3);
for row_index = 1:3
 distances(row_index) = sum((training_points(row_index,:)-query_point).^2);
end
best_index = 1;
for row_index = 2:3
 if distances(row_index) < distances(best_index)
  best_index = row_index;
 end
end
predicted_label = labels(best_index);

% {{ comments.check[lang] }}
example_check = predicted_label == 2 && distances(best_index) == 0.25
