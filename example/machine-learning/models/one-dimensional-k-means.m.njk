% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

samples = [0,1,2,8,9,10]; centers = [0,10]; assignments = zeros(1,6);
for step_index = 1:4
 for item_index = 1:6
  assignments(item_index) = 1;
  if abs(samples(item_index)-centers(2)) < abs(samples(item_index)-centers(1))
   assignments(item_index) = 2;
  end
 end
 for cluster_index = 1:2
  selected = samples(assignments == cluster_index); centers(cluster_index) = sum(selected)/length(selected);
 end
end

% {{ comments.check[lang] }}
example_check = all(centers == [1,9]) && all(assignments == [1,1,1,2,2,2])
