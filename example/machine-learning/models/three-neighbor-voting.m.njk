% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

training_values = [0,1,2,7,8]; labels = [1,1,2,2,2]; query_value = 1.2; distances = (training_values-query_value).^2; votes = zeros(1,2); best_slot = [1,0];
for neighbor_index = 1:3
 best_slot(1) = 1;
 for item_index = 2:5
  if distances(item_index) < distances(best_slot(1))
   best_slot(1) = item_index;
  end
 end
 votes(labels(best_slot(1))) = votes(labels(best_slot(1)))+1; distances(best_slot(1)) = 1e6;
end
predicted_label = 1;
if votes(2) > votes(1)
 predicted_label = 2;
end

% {{ comments.check[lang] }}
example_check = predicted_label == 1 && all(votes == [2,1])
