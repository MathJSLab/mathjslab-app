---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

features = [-2,-1,1,2]; labels = [-1,-1,1,1]; weight_value = 0; bias_value = 0;
for epoch_index = 1:4
 for item_index = 1:4
  score_value = weight_value*features(item_index)+bias_value;
  if labels(item_index)*score_value <= 0
   weight_value = weight_value+labels(item_index)*features(item_index); bias_value = bias_value+labels(item_index);
  end
 end
end
margins = labels.*(weight_value*features+bias_value);

% {{ comments.check[lang] }}
example_check = all(margins > 0)
