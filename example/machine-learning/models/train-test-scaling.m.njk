---json
{
    "comments": {
        "title": {
            "en": "Training-only feature scaling",
            "es": "Escalado con datos de entrenamiento",
            "pt": "Escala com dados de treinamento"
        },
        "goal": {
            "en": "Reuse training mean and scale on held-out samples.",
            "es": "Reutilizar media y escala del entrenamiento en muestras reservadas.",
            "pt": "Reutilizar média e escala do treinamento em amostras reservadas."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        },
        "reference": {
            "en": "Topic reference (independently written example): https://github.com/TheAlgorithms/MATLAB-Octave",
            "es": "Referencia temática (ejemplo escrito de forma independiente): https://github.com/TheAlgorithms/MATLAB-Octave",
            "pt": "Referência temática (exemplo escrito de forma independente): https://github.com/TheAlgorithms/MATLAB-Octave"
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

training_values = [2,4,6]; test_values = [8,10]; center_value = sum(training_values)/3;
scale_value = sqrt(sum((training_values-center_value).^2)/3);
scaled_training = (training_values-center_value)/scale_value; scaled_test = (test_values-center_value)/scale_value;

% {{ comments.check[lang] }}
example_check = abs(sum(scaled_training)) < 1e-10 && abs(sum(scaled_training.^2)/3-1) < 1e-10 && all(scaled_test > 2)
