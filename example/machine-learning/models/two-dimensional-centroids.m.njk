% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

samples = [0,0;0,2;8,8;10,8]; centers = [0,0;10,10]; assignments = zeros(1,4);
for step_index = 1:3
 for item_index = 1:4
  d1 = sum((samples(item_index,:)-centers(1,:)).^2); d2 = sum((samples(item_index,:)-centers(2,:)).^2);
  assignments(item_index) = 1;
  if d2 < d1
   assignments(item_index) = 2;
  end
 end
 for cluster_index = 1:2
  selected = samples(assignments == cluster_index,:); centers(cluster_index,:) = sum(selected,1)/size(selected,1);
 end
end

% {{ comments.check[lang] }}
example_check = max(max(abs(centers-[0,1;9,8]))) < 1e-10
