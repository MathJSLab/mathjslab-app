---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

features = [-2,-1,0,1,2]; scores = 2*features-0.5;
probabilities = 1./(1+exp(-scores)); predictions = probabilities >= 0.5;

% {{ comments.check[lang] }}
example_check = all(predictions == [0,0,0,1,1]) && all(probabilities > 0 & probabilities < 1)
