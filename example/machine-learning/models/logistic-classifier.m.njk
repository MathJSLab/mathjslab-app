{
    "comments": {
        "title": {
            "en": "Logistic classifier",
            "es": "Clasificador logístico",
            "pt": "Classificador logístico"
        },
        "goal": {
            "en": "Convert linear scores into probabilities and threshold the result.",
            "es": "Convertir puntuaciones lineales en probabilidades y aplicar un umbral.",
            "pt": "Converter pontuações lineares em probabilidades e aplicar um limiar."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        },
        "reference": {
            "en": "Topic reference (independently written example): https://github.com/TheAlgorithms/MATLAB-Octave",
