---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

z = 5+12i
conjugate_value = conj(z)
magnitude = abs(z)
squared_magnitude = z*conjugate_value
real_part = real(z)
imaginary_part = imag(z)

% {{ comments.check[lang] }}
example_check = magnitude == 13 && squared_magnitude == 169 && real_part == 5 && imaginary_part == 12
