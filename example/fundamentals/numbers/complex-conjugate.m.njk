---json
{
    "comments": {
        "title": {
            "en": "Complex conjugates",
            "es": "Conjugados complejos",
            "pt": "Conjugados complexos"
        },
        "goal": {
            "en": "Multiply a complex number by its conjugate to obtain its squared magnitude.",
            "es": "Multiplicar un número complejo por su conjugado para obtener su magnitud al cuadrado.",
            "pt": "Multiplicar um número complexo pelo conjugado para obter o quadrado do módulo."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
