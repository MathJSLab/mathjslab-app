---json
{
    "comments": {
        "title": {
            "en": "Complex division",
            "es": "División compleja",
            "pt": "Divisão complexa"
        },
        "goal": {
            "en": "Compare direct division with multiplication by a conjugate.",
            "es": "Comparar división directa con multiplicación por un conjugado.",
            "pt": "Comparar divisão direta com multiplicação por um conjugado."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

numerator_value = 4+2i
denominator_value = 1-1i
quotient_value = numerator_value/denominator_value
expanded_value = numerator_value*conj(denominator_value)/abs(denominator_value)^2

% {{ comments.check[lang] }}
example_check = abs(quotient_value-(1+3i)) < 1e-10 && abs(quotient_value-expanded_value) < 1e-10
