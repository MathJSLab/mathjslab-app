---json
{
    "comments": {
        "title": {
            "en": "Logarithm change of base",
            "es": "Cambio de base del logaritmo",
            "pt": "Mudança de base do logaritmo"
        },
        "goal": {
            "en": "Calculate base-two logarithms using natural logarithms.",
            "es": "Calcular logaritmos de base dos usando logaritmos naturales.",
            "pt": "Calcular logaritmos de base dois usando logaritmos naturais."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

values = [1,2,8,32]
base_two_logs = log(values)/log(2)
reconstructed = 2.^base_two_logs

% {{ comments.check[lang] }}
example_check = max(abs(base_two_logs-[0,1,3,5])) < 1e-10 && max(abs(reconstructed-values)) < 1e-10
