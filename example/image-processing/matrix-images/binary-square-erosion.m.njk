% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

image_values = zeros(5,5); image_values(2:4,2:4) = 1; eroded_values = zeros(5,5);
for row_index = 2:4
 for column_index = 2:4
  patch = image_values(row_index-1:row_index+1,column_index-1:column_index+1); eroded_values(row_index,column_index) = min(min(patch));
 end
end

% {{ comments.check[lang] }}
example_check = sum(sum(eroded_values)) == 1 && eroded_values(3,3) == 1
