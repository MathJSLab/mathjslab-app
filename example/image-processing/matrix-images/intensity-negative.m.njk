% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

image_values = [0,0.25;0.75,1]; negative_values = 1-image_values; recovered = 1-negative_values;

% {{ comments.check[lang] }}
example_check = max(max(abs(recovered-image_values))) < 1e-10 && negative_values(1,1) == 1
