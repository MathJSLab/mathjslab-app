% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
% {{ comments.reference[lang] }}
clear

image_values = zeros(5,5); image_values(3,3) = 1; dilated_values = zeros(5,5);
for row_index = 2:4
 for column_index = 2:4
  neighborhood = [image_values(row_index,column_index),image_values(row_index-1,column_index),image_values(row_index+1,column_index),image_values(row_index,column_index-1),image_values(row_index,column_index+1)];
  dilated_values(row_index,column_index) = max(neighborhood);
 end
end

% {{ comments.check[lang] }}
example_check = sum(sum(dilated_values)) == 5 && dilated_values(3,2) == 1 && dilated_values(2,2) == 0
