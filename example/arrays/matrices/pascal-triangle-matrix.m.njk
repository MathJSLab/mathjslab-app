---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

triangle = zeros(7,7);
triangle(:,1) = 1;
for row_index = 2:7
  for column_index = 2:row_index
    triangle(row_index,column_index) = triangle(row_index-1,column_index-1)+triangle(row_index-1,column_index);
  end
end
last_row = triangle(7,:)

% {{ comments.check[lang] }}
example_check = all(last_row == [1,6,15,20,15,6,1]) && sum(last_row) == 64
