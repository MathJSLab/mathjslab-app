---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [1,2;3,4]
B = [1,0;0,2]
block_product = [A(1,1)*B,A(1,2)*B;A(2,1)*B,A(2,2)*B]

% {{ comments.check[lang] }}
example_check = all(size(block_product) == [4,4]) && block_product(4,4) == 8 && trace(block_product) == 15
