---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

A = [1,2;3,4]
B = [2,0;1,2]
matrix_product = A*B
element_product = A.*B

% {{ comments.check[lang] }}
example_check = all(all(matrix_product == [4,4;10,8])) && all(all(element_product == [2,0;3,8]))
