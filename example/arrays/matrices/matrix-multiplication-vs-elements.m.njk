{
    "comments": {
        "title": {
            "en": "Matrix versus element products",
            "es": "Productos matriciales y por elementos",
            "pt": "Produtos matriciais e por elementos"
        },
        "goal": {
            "en": "Compare a matrix product with multiplication at corresponding positions.",
            "es": "Comparar un producto matricial con multiplicación en posiciones correspondientes.",
            "pt": "Comparar um produto matricial com multiplicação nas posições correspondentes."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
