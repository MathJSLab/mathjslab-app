% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

weights = [2,3,5;1,1,2]
probabilities = zeros(2,3);
for row_index = 1:2
  probabilities(row_index,:) = weights(row_index,:)/sum(weights(row_index,:));
end
probabilities

% {{ comments.check[lang] }}
example_check = max(abs(sum(probabilities,2)-1)) < 1e-10 && probabilities(2,3) == 0.5
