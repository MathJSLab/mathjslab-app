---json
{
    "comments": {
        "title": {
            "en": "Velocity from samples",
            "es": "Velocidad a partir de muestras",
            "pt": "Velocidade a partir de amostras"
        },
        "goal": {
            "en": "Divide position differences by unequal time intervals.",
            "es": "Dividir diferencias de posición por intervalos de tiempo desiguales.",
            "pt": "Dividir diferenças de posição por intervalos de tempo desiguais."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

times = [0,1,3,6]
positions = [0,2,8,20]
velocities = diff(positions)./diff(times)

% {{ comments.check[lang] }}
example_check = all(velocities == [2,3,4])
