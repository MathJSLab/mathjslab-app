---json
{
    "comments": {
        "title": {
            "en": "Colon sequences",
            "es": "Secuencias con dos puntos",
            "pt": "Sequências com dois-pontos"
        },
        "goal": {
            "en": "Build increasing and decreasing arithmetic sequences with explicit steps.",
            "es": "Construir secuencias aritméticas crecientes y decrecientes con pasos explícitos.",
            "pt": "Construir sequências aritméticas crescentes e decrescentes com passos explícitos."
        },
        "check": {
            "en": "Check the expected result; true means the check passed.",
            "es": "Comprobar el resultado esperado; true indica que la comprobación pasó.",
            "pt": "Verificar o resultado esperado; true indica que a verificação passou."
        }
    }
}
---
% {{ comments.title[lang] }}
% {{ comments.goal[lang] }}
clear

odd_numbers = 1:2:11
countdown = 10:-2:0
combined_total = sum(odd_numbers)+sum(countdown)

% {{ comments.check[lang] }}
example_check = all(odd_numbers == [1,3,5,7,9,11]) && combined_total == 66
