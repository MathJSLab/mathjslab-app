{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist/markdown-document/types",
        "rootDir": "."
    },
    "include": [
        "src/markdown-document.ts",
        "src/markdown-core.ts",
        "src/markdown-component.ts",
        "src/markdown-component-register.ts",
        "src/markdown-extensions.ts",
        "src/markdown-mathjslab.ts",
        "src/markdown-mathjslab-worker.ts",
        "types/**/*.d.ts"
    ]
}
