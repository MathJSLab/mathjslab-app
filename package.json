{
    "name": "mathjslab-app",
    "version": "1.23.0",
    "description": "MathJSLab - An interpreter with language syntax like MATLAB®/Octave, ISBN 978-65-00-82338-7. A demo application from the mathjslab npm package, ISBN 978-65-00-84828-1.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MathJSLab/mathjslab-app.git"
    },
    "keywords": [
        "MathJSLab",
        "Mathematics",
        "Educational",
        "MATLAB",
        "Octave",
        "MathML",
        "ANTLR",
        "ANTLR4",
        "math",
        "lexer",
        "parser",
        "grammar",
        "interpreter"
    ],
    "author": "MathJSLab <mathjslab@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/MathJSLab/mathjslab-app/issues"
    },
    "homepage": "https://mathjslab.com/",
    "type": "module",
    "scripts": {
        "clean:package-lock": "node script/clean-dependencies.mjs",
        "clean:eleventy": "shx rm -rf dist/example/en dist/example/es dist/example/pt sitemap.xml robots.txt mathjslab-en.bib mathjslab-pt.bib mathjslab-es.bib src/main.html src/en/index.html src/es/index.html src/pt/index.html",
        "clean:build": "shx rm -rf dist report src/first-example.json src/build-configuration.json",
        "clean:repository": "shx rm -rf repo",
        "clean:script": "shx rm -rf script/build",
        "clean:android": "shx rm -rf android",
        "clean:webapp": "npm run clean:android",
        "clean:eleventy:build:script:webapp": "npm run clean:eleventy && npm run clean:build && npm run clean:script && npm run clean:webapp",
        "clean:copy": "npm run npx:tsx -- script/helper/copy-repo-files.ts clean && npx shx rm -rf script/helper/copy-repo-files.ts",
        "clean": "npm run clean:eleventy:build:script:webapp",
        "clean:all": "npm run clean && npm run clean:copy && npm run clean:package-lock",
        "clone:repository": "shx rm -rf repo && shx mkdir -p repo && git clone https://github.com/MathJSLab/.github.git repo/.github",
        "precopy:repository": "shx cp repo/.github/script/helper/copy-repo-files.ts script/helper/copy-repo-files.ts",
        "copy:repository": "npm run tsx -- script/helper/copy-repo-files.ts",
        "set:prettierrc": "node -e \"import fs from 'fs';const f='.prettierrc';let j=JSON.parse(fs.readFileSync(f));j.overrides.filter((c)=>c.files==='*.md')[0].options.printWidth=79;fs.writeFileSync(f,JSON.stringify(j,null,2));\"",
        "clone:copy:clean:repository": "npm run clone:repository && npm run copy:repository && npm run clean:repository",
        "postclone:copy:clean:repository": "npm run set:prettierrc",
        "install:capacitor": "npm install @capacitor/core && npm install --save-dev @capacitor/cli",
        "remove:capacitor": "npm remove @capacitor/core @capacitor/cli",
        "install:android": "npm install @capacitor/android",
        "remove:android": "npm remove @capacitor/android",
        "install:webapp": "npm run install:capacitor && npm run install:android",
        "remove:webapp": "npm run remove:android && npm run remove:capacitor",
        "install:approve:all": "npm install-scripts approve --all && npm install",
        "install:all": "npm install && npm run clone:copy:clean:repository && npm run clean && npm run build:script",
        "update": "npx npm-check-updates -u && npm run install:all",
        "disabled:pregit:add": "replace-in-file --verbose --configFile=replace.fix-linebreak.json",
        "git:add": "git add .",
        "git:commit": "node script/helper/git-commit.cjs",
        "git:push": "git push",
        "git:all": "npm run git:add && npm run git:commit && npm run git:push",
        "tsx": "tsx --require tsconfig-paths/register",
        "npx:tsx": "npx tsx",
        "crono:start": "npm run tsx script/helper/mark-crono.ts -- start",
        "crono:mark": "npm run tsx script/helper/mark-crono.ts -- mark",
        "crono:stop": "npm run tsx script/helper/mark-crono.ts -- stop",
        "format": "prettier --plugin=@prettier/plugin-xml --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,css,scss,html,htm,json,jsonc,yml,yaml,xml,md}\"",
        "postformat": "replace-in-file --verbose --configFile=replace.fix-linebreak.json",
        "lint": "eslint --fix",
        "format:lint": "npm run format && npm run lint",
        "build:script": "tsc --project script/tsconfig.json",
        "build:eleventy": "node eleventy.build.mjs",
        "build:assets": "node script/build-assets.cjs",
        "build:markdown-component": "tsx --require tsconfig-paths/register ./node_modules/webpack/bin/webpack --config webpack.markdown.config.ts --mode production",
        "build:markdown-test-worker": "tsx --require tsconfig-paths/register ./node_modules/webpack/bin/webpack --config webpack.markdown-test-worker.config.ts --mode production",
        "build:test-browser": "npm run build:markdown-component && npm run build:markdown-test-worker && npm run build:prod",
        "pretest:browser": "npm run build:test-browser",
        "test:browser": "playwright test",
        "pretest:browser:all": "npm run build:test-browser",
        "test:browser:all": "npm run test:browser:all:run",
        "test:browser:serve": "node script/serve-markdown-browser-tests.mjs",
        "prebuild:dev": "npm run verify:hdl:assets && npm run build:eleventy && npm run build:assets",
        "build:development": "tsx --require tsconfig-paths/register ./node_modules/webpack-dev-server/bin/webpack-dev-server --mode development",
        "build:production": "tsx --require tsconfig-paths/register ./node_modules/webpack/bin/webpack --mode production",
        "build:dev": "npm run build:development",
        "prebuild:debug": "cross-env DEBUG=true npm run prebuild:dev",
        "build:debug": "npm run build:development",
        "prebuild:prod": "npm run prebuild:dev",
        "build:prod": "npm run build:production",
        "build": "npm run build:prod",
        "add:android": "npx cap add android",
        "sync:android": "npx cap sync android",
        "build:add:android": "npm run build && npm run add:android",
        "build:sync:android": "npm run build && npm run sync:android",
        "open:android": "npx cap open android",
        "build:add:open:android": "npm run build:add:android && npm run open:android",
        "build:sync:open:android": "npm run build:sync:android && npm run open:android",
        "build:all": "npm run clean && npm run update && npm run build:add:android",
        "test:markdown": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects markdown-compatibility-tests --runInBand --verbose",
        "test:markdown:legacy": "node script/markdown.test.mjs",
        "measure:markdown": "node script/measure-markdown-chunks.mjs",
        "test:examples": "npm run build:eleventy && npm run build:assets && npm run test:examples:run",
        "pretest": "npm run build:eleventy && npm run build:assets",
        "test:docs": "node script/check-documentation.mjs",
        "test:types": "tsc --project tsconfig.jest.json --noEmit",
        "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
        "test:infrastructure": "node --test test/examples/example-assets.test.cjs test/infrastructure/*.test.mjs",
        "test": "npm run test:checks",
        "test:markdown:all": "npm run test:markdown && npm run test:markdown:legacy",
        "prepare:markdown:local": "node script/prepare-markdown-local.mjs",
        "verify:hdl:assets": "node script/verify-hdl-assets.mjs",
        "test:hdl:browser": "node script/test-hdl-browser.mjs",
        "do:all": "node script/do-all.mjs",
        "install:browsers": "playwright install chromium firefox webkit",
        "test:checks": "npm run test:docs && npm run test:examples:coverage && npm run test:types && npm run test:unit && npm run test:infrastructure && npm run test:markdown:legacy",
        "test:examples:run": "node script/test-examples.mjs",
        "test:browser:all:run": "cross-env MARKDOWN_BROWSER_PROJECTS=all playwright test --workers=1 --retries=0",
        "verify:hdl:assets:built": "node script/verify-hdl-assets.mjs dist/hdl",
        "test:examples:coverage": "node script/check-markdown-examples.mjs",
        "prebuild:markdown-test-worker": "npm run build:eleventy && npm run build:assets"
    },
    "devDependencies": {
        "@11ty/eleventy": "^3.1.7",
        "@11ty/eleventy-img": "^7.1.1",
        "@playwright/test": "1.64.1",
        "@prettier/plugin-xml": "^3.4.2",
        "@resvg/resvg-js": "^2.6.2",
        "@types/jest": "^30.0.0",
        "@types/node": "24.10.1",
        "@types/plotly.js-dist-min": "^2.3.4",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "ajv": "^8.20.0",
        "chalk": "^6.0.0",
        "coffeescript": "^2.7.1",
        "cross-env": "^10.1.0",
        "cson": "^8.4.0",
        "css-loader": "^7.1.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "html-webpack-plugin": "^5.6.8",
        "intl-messageformat": "^12.1.4",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jimp": "^1.6.1",
        "json5": "^2.2.3",
        "mini-css-extract-plugin": "^2.10.2",
        "node-html-parser": "^9.0.5",
        "png-to-ico": "^3.0.2",
        "prettier": "^3.9.10",
        "replace-in-file": "^9.0.0",
        "sass": "^1.106.1",
        "sass-loader": "^17.1.0",
        "shx": "^0.4.0",
        "smol-toml": "^1.9.1",
        "style-loader": "^4.0.0",
        "ts-jest": "^29.4.15",
        "ts-loader": "^9.6.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "uuid": "^14.0.3",
        "webpack": "^5.112.2",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.1.0",
        "yaml": "^2.9.1"
    },
    "dependencies": {
        "highlight.js": "^11.12.0",
        "marked": "^18.1.2",
        "mathjslab": "^2.9.0",
        "mathjslab-markdown": "^0.9.2",
        "plotly.js-dist-min": "^4.1.2"
    },
    "allowScripts": {
        "unrs-resolver": true,
        "esbuild": true,
        "@parcel/watcher": true
    }
}
